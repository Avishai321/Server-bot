<configuration>
    <!-- Standard Console Output (For systemd journal) -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!--
              No date pattern here. Systemd provides the timestamp.
              [%thread]  -> Keeps the thread name
              %-5level   -> Aligns INFO/WARN/ERROR
              %logger{0} -> Shortens com.avishai...SpotifyService to just SpotifyService
            -->
            <pattern>[%thread] %-5level %logger{0} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Daily Rolling File Output -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/homebot.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/archive/homebot.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>

        <encoder>
            <!-- File gets the custom MM/dd HH:mm:ss format -->
            <pattern>%d{MM/dd HH:mm:ss} [%thread] %-5level %logger{0} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
